FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# 資料庫：XAMPP 的 MySQL 預設 3306。start_system.bat 第一次執行會把 DB_PASSWORD、SECRET_KEY 換成隨機值，
# 並用 root 建好資料庫與帳號；XAMPP 的 root 若有設密碼，加一行 MYSQL_ROOT_PASSWORD=密碼
# 系統網址埠號預設 5013，被占用時可加一行 APP_PORT=其他埠號
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_learning_portfolio
DB_USER=smart_learning_app
DB_PASSWORD=change-this-password

ADMIN_DEFAULT_PASSWORD=admin123

UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH_MB=10

# AI（Google Gemini）：到 https://aistudio.google.com/ 申請金鑰，填在自己的 .env，不要 commit
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_MODEL=gemini-flash-lite-latest

# 本機 Google Drive 展示原型（只讀使用者透過 Google Picker 選取的檔案中繼資料）
# 在 Google Cloud 啟用 Drive API 與 Picker API，建立 OAuth 網頁用戶端及 API 金鑰後再填入。
# API 金鑰請限制可用 API 與 localhost 網址；不得把真實設定值提交到 Git。
GOOGLE_DRIVE_PREVIEW_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# 自傳在 Google 文件中編輯（後端 OAuth 授權碼流程，只要 drive.file 權限）
# 三個值都填才會開放；少一個時自傳頁顯示「Google 尚未設定」，其他功能照常。
# 用戶端 ID 可和上面的 Picker 原型共用同一個 OAuth 網頁用戶端；密鑰只放自己的 .env，不得提交或貼到對話。
# 重新導向網址要和 Google Cloud「已授權的重新導向 URI」完全一致。
# 設定步驟：docs/03_開發紀錄/01_參考與環境設定/Google文件自傳編輯_設定步驟.md
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5013/student/google/callback
# 學生上傳檔案改存 Google 雲端硬碟：填 google_drive 並填好上面的用戶端 ID、密鑰才會生效；不填或 local 就存本機。
# 網站啟動後還要由管理員到「檔案存放設定」按「連上 Google 雲端硬碟」（權杖只放記憶體，網站重開要再連一次）。
# 重新導向網址的主機與埠號要和開站網址、Google Cloud「已授權的重新導向 URI」完全一致。
# 設定步驟：docs/03_開發紀錄/01_參考與環境設定/Google雲端硬碟存放_設定步驟.md
STORAGE_BACKEND=local
GOOGLE_STORAGE_REDIRECT_URI=http://127.0.0.1:5021/admin/storage/google/callback
# 招生資料 Agent 只擷取科系名稱含這些字的校系
AGENT_PROGRAM_KEYWORDS=資訊管理,資管,資訊應用,資訊工程

# 文件分析（OCR）：圖片與 PDF 都只在本機辨識，不送外部服務
# fake＝測試用假資料；rapidocr＝組員的 OCR 流程＋本機 RapidOCR PP-OCRv5（建議）
# tesseract／ocr＝本機 Tesseract（需另裝 Tesseract 程式）；paddleocr＝本機 PaddleOCR（需 Python 3.12，見 docs/ocr-setup.md）
# 真實 OCR 支援 JPG／PNG 與 PDF（最多 10 頁，逐頁 300 DPI）
# 使用 rapidocr 前先執行 python scripts/download_ocr_models.py 下載模型到 instance/ocr-models
DOCUMENT_ANALYSIS_PROVIDER=rapidocr
# 模型等級：server＝伺服器版（預設，較準、較慢、記憶體約 2 GB）；mobile＝輕量版（較快、約 0.7 GB）
OCR_MODEL_TIER=server
# 執行裝置：cpu＝一般處理器（預設）；dml＝Windows 顯示卡加速（需改裝 onnxruntime-directml，見 requirements-directml.txt）
OCR_DEVICE=cpu
# DirectML 顯示卡編號：筆電的 0 多半是內建顯示，獨立顯示卡常是 1
OCR_DML_DEVICE_ID=0
